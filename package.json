{
  "name": "dungeon-gym-core",
  "version": "0.1.0",
  "description": "Deterministic headless core of Dungeon Gym: a turn-based dungeon roguelite with trainable bot genomes (SRD 5.1 rules subset).",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "dist",
    "LICENSE",
    "LICENSE-SRD.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "node scripts/build.mjs",
    "cli": "node dist/cli.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "bin": {
    "dungeon-gym": "dist/cli.mjs"
  }
}
