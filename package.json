{
  "name": "dungeon-gym-core",
  "version": "0.1.0",
  "description": "Deterministic headless core of Dungeon Gym: a turn-based dungeon roguelite with trainable bot genomes (SRD 5.1 rules subset).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximilianVII/dungeon-gym.git"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./genomes/*.json": "./genomes/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "genomes/*.json",
    "LICENSE",
    "LICENSE-SRD.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "node scripts/build.mjs && node scripts/build-lib.mjs",
    "prepare": "npm run build",
    "cli": "node dist/cli.mjs",
    "smoke": "node scripts/smoke-cli.mjs",
    "bench:check": "npm run build && node scripts/bench-baseline.mjs check",
    "bench:update": "npm run build && node scripts/bench-baseline.mjs update",
    "pack:check": "node scripts/pack-check.mjs",
    "check": "npm run typecheck && npm run coverage && npm run bench:check && npm run smoke"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "bin": {
    "dungeon-gym": "dist/cli.mjs"
  }
}
